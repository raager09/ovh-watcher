# --- What to watch -----------------------------------------------------------
# Plan code(s) from `--list` (comma-separated). REQUIRED for watch mode.
PLAN_CODES=
# ...or instead: regex on catalog name/CPU, resolved to plan codes at runtime
PLAN_MATCH=
# Datacenters to watch (North America: bhs=Beauharnois, hil=Hillsboro, vin=Vint Hill)
DATACENTERS=bhs,hil,vin
# Which OVH APIs to poll: us, ca, or both ("us,ca"). Stock can differ per subsidiary.
OVH_ENDPOINTS=us
# Regexes (case-insensitive) matched against the storage / memory codes from the API
STORAGE_INCLUDE=nvme|ssd
STORAGE_EXCLUDE=hdd|sata
MEMORY_INCLUDE=

# --- Notifications -----------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY
# Role (<@&ROLE_ID>) or user (<@USER_ID>) to ping on in-stock alerts
DISCORD_MENTION=
# Direct order page, linked from the alert
ORDER_URL=
# Text used in alert titles: "🟢 <ALERT_LABEL> in stock — <datacenter>"
ALERT_LABEL=KS-6 NVMe
# Optional second notifier (ntfy.sh or self-hosted)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# --- Timing / state ----------------------------------------------------------
POLL_SECONDS=180
# Daily heartbeat in local time (HH:MM), or "off". Set TZ so this is your local time.
HEARTBEAT_TIME=09:00
TZ=America/Toronto
STATE_PATH=/data/state.json
